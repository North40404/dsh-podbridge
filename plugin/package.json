{
  "name": "dsh-podbridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "把聊天客户端的消息投进 DSH 会话，把会话回复推回客户端（协议见 docs/podbridge-协议-v1.md）",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "src",
    "locale/*.json",
    "README.md"
  ],
  "scripts": {
    "test": "node --test --test-isolation=none test/"
  },
  "license": "MIT"
}
